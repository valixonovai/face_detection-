# Bu faylni `.env` nomi bilan nusxalang va o'z qiymatlaringizni yozing.
# `.env` git'ga tushmaydi (.gitignore'da).

# ---- PostgreSQL (docker-compose standart bazasi) -----------------------
# Bo'sh qoldirmang — dashboard, kuzatuv worker'i va Telegram bot shu
# bazaga bir vaqtda ulanadi.
POSTGRES_PASSWORD=
# Ixtiyoriy, standart qiymatlar yetarli bo'lsa o'zgartirmang:
# POSTGRES_DB=attendance
# POSTGRES_USER=attendance

# ---- Telegram bot -------------------------------------------------------
# @BotFather'dan olingan token ("/newbot" buyrug'i orqali yaratiladi)
TELEGRAM_BOT_TOKEN=

# Botdan foydalanishga ruxsat berilgan Telegram user_id'lar, vergul bilan
# ajratilgan (masalan: 123456789,987654321). O'z ID'ingizni bilish uchun
# Telegram'da @userinfobot ga /start yozing, yoki botni tokensiz bo'lsa
# ham /start qiling — u sizga ID'ingizni ko'rsatadi.
TELEGRAM_ADMIN_IDS=

# ---- Hikvision kamerani birinchi marta avtomatik qo'shish (ixtiyoriy) ---
# Kameralar endi "Kameralar" sahifasida (UI orqali) boshqariladi — bu
# o'zgaruvchilar faqat docker-compose.yml'dagi CAMERAS_JSON izohini
# yoqmoqchi bo'lsangiz kerak.
CAMERA_HOST=192.168.1.64
CAMERA_USER=admin
CAMERA_PASSWORD=

# ---- AWS RDS PostgreSQL ishlatilganda (compose'dagi Postgres o'rniga) ---
# Yoqilsa yuqoridagi POSTGRES_* o'rniga shu URL ishlatiladi (docker-compose.yml
# ichida DATABASE_URL ni shunga o'zgartiring):
# DATABASE_URL=postgresql+psycopg2://user:parol@rds-endpoint:5432/attendance
